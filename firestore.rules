rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The single users collection — doc presence == "may sign in to
    // /admin". A user can read or mutate this list iff their own mobile
    // is already on it (users manage users — there is no separate
    // admin tier). End users at `/` are anonymous and never touch this
    // collection (see docs/CLAUDE-AUTH.md).
    //
    // Doc id is the E.164 mobile, compared directly against the
    // `phone_number` claim. No case folding needed (unlike the email it
    // replaced) — a phone number has exactly one normalised spelling,
    // which is why every write path runs through normalizeAuMobile.
    //
    // Bootstrap: the project owner's mobile is seeded at project
    // creation so they can use the app on day one. If the list is
    // ever emptied (everyone removes everyone), recovery requires
    // out-of-band access (Firebase Console or Admin SDK).
    match /users/{mobileDocId} {
      allow read, write: if request.auth != null
        && request.auth.token.phone_number != null
        && exists(/databases/$(database)/documents/users/$(request.auth.token.phone_number));
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
